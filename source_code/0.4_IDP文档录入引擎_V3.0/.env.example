# 成都建工 IDP V3.0 local runtime

# Primary semantic extraction model
LING_ENABLED=1
LING_BASE_URL=http://127.0.0.1:8000/v1
LING_MODEL=Ling-3.0-tiny
LING_API_KEY=local
LING_TIMEOUT_SECONDS=120

# OCR: engine is initialized only when a scan/image actually needs OCR
OCR_ENABLED=1
OCR_LANG=ch
OCR_PDF_DPI=180

# Optional second-line audit model. OFF by default on low-resource hosts.
GRANITE_ENABLED=0
GRANITE_BASE_URL=http://127.0.0.1:8001/v1
GRANITE_MODEL=granite-4.2-3b
GRANITE_API_KEY=local
GRANITE_TIMEOUT_SECONDS=180
# Optional business materiality threshold. Empty/0 disables amount-only triggering.
# Set this only after finance/audit defines the project policy, e.g. 500000.
GRANITE_MIN_AMOUNT=

# PostgreSQL persistence. Leave empty only for extraction-only development.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/chengdu_construction

# Original document storage
STORE_ORIGINALS=1
IDP_STORAGE_DIR=./storage/originals
