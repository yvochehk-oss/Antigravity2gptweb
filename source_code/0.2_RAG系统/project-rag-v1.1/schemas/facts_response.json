{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Facts Response",
  "description": "Facts Provider 响应格式",
  "type": "object",
  "required": [
    "project_code",
    "as_of",
    "facts_version",
    "status",
    "facts_available",
    "metrics",
    "source"
  ],
  "properties": {
    "project_code": {
      "type": "string",
      "description": "项目编码"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "description": "数据截止时间（ISO 8601）"
    },
    "facts_version": {
      "type": "string",
      "description": "Facts 版本标识（UUID）"
    },
    "status": {
      "type": "string",
      "enum": ["AVAILABLE", "DEGRADED"],
      "description": "Canonical Facts 可用状态；DEGRADED 时不得生成确定性财务结论"
    },
    "facts_available": {
      "type": "boolean",
      "description": "是否具备完整的 analytics_project_full 事实数据"
    },
    "reason": {
      "type": ["string", "null"],
      "description": "不可用或不完整的原因；不以默认值替代"
    },
    "source": {
      "type": "string",
      "description": "事实来源，例如 analytics_project_full 或 facts_snapshots"
    },
    "metrics": {
      "type": "object",
      "description": "指标值字典",
      "additionalProperties": {
        "$ref": "#/definitions/MetricValue"
      }
    }
  },
  "definitions": {
    "MetricValue": {
      "type": "object",
      "required": ["value", "metric_version"],
      "properties": {
        "value": {
          "type": "number",
          "description": "指标值"
        },
        "metric_version": {
          "type": "string",
          "description": "指标版本"
        },
        "unit": {
          "type": "string",
          "description": "单位"
        }
      }
    }
  }
}
