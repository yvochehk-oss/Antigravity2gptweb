APP_ENV=development
PROJECT_RAG_HOST=127.0.0.1
PROJECT_RAG_PORT=8922
PROJECT_RAG_DB_URL=postgresql+psycopg://projectrag:projectrag@127.0.0.1:5432/projectrag
PROJECT_RAG_DATA_DIR=./data
PROJECT_RAG_IMPORT_ROOT=./data/imports
PROJECT_RAG_EMBEDDING_DIM=1024
PROJECT_RAG_EMBEDDING_BACKEND=bge_m3
# Optional local-model overrides.  Leave blank when using the V2.0 launchers:
# they derive <V2_ROOT>/models/bge-m3 and preserve any explicit environment
# override.  For direct uvicorn invocation, set an absolute local path here.
PROJECT_RAG_EMBEDDING_MODEL=
PROJECT_RAG_RERANKER_BACKEND=bge_v2_m3
# Optional local-model override; see PROJECT_RAG_EMBEDDING_MODEL above.
PROJECT_RAG_RERANKER_MODEL=
PROJECT_RAG_AUTO_START_WORKER=1
PROJECT_RAG_AUTH_REQUIRED=0
# Shared bearer between Tax and RAG.  Required when binding outside loopback or
# when PROJECT_RAG_AUTH_REQUIRED=1.  Prefer the file form for local/production
# secret-manager injection.  The path may be absolute or relative to this RAG
# directory; never commit the credential file.  If both sources are set they
# must contain the same value.
RAG_SHARED_API_KEY_FILE=
RAG_SHARED_API_KEY=
JWT_SECRET_KEY=
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
# Managed by V2.0/start_all.sh after the local llama.cpp /health check.
# These are a non-persistent final fallback; database model rows keep priority.
RAG_LLM_LOCAL_BASE_URL=
RAG_LLM_LOCAL_MODEL=
RAG_LLM_LOCAL_TIMEOUT_SECONDS=60
