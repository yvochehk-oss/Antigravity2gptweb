APP_ENV=development
PROJECT_RAG_HOST=127.0.0.1
PROJECT_RAG_PORT=8922
PROJECT_RAG_DB_URL=postgresql+psycopg://projectrag:projectrag@127.0.0.1:5432/projectrag
PROJECT_RAG_DATA_DIR=./data
PROJECT_RAG_IMPORT_ROOT=./data/imports

# Retrieval: BGE-M3 remains the semantic embedding model.
PROJECT_RAG_EMBEDDING_DIM=1024
PROJECT_RAG_EMBEDDING_BACKEND=bge_m3
# Optional local-model override. V2 launchers may derive <V2_ROOT>/models/bge-m3.
PROJECT_RAG_EMBEDDING_MODEL=

# Cross-encoder reranking is optional and OFF by default for 16GB CPU hosts.
# Enable only after measuring that retrieval quality needs the extra model.
PROJECT_RAG_RERANKER_ENABLED=0
PROJECT_RAG_RERANKER_BACKEND=bge_v2_m3
PROJECT_RAG_RERANKER_MODEL=

PROJECT_RAG_AUTO_START_WORKER=1
PROJECT_RAG_AUTH_REQUIRED=0
# Shared bearer between Tax and RAG. Required for non-loopback/protected deployments.
RAG_SHARED_API_KEY_FILE=
RAG_SHARED_API_KEY=
JWT_SECRET_KEY=

# Main OpenAI-compatible generation model: Ling-3.0-tiny.
RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
RAG_LLM_MODEL=Ling-3.0-tiny
RAG_LLM_API_KEY=local
# Managed launchers may override these only after their local model health check.
RAG_LLM_LOCAL_BASE_URL=
RAG_LLM_LOCAL_MODEL=
RAG_LLM_LOCAL_TIMEOUT_SECONDS=60
