APP_ENV=development
PROJECT_RAG_HOST=127.0.0.1
PROJECT_RAG_PORT=8922
# Windows V3 canonical portable PostgreSQL endpoint. Do not silently fall back to 5432.
PROJECT_RAG_DB_URL=postgresql+psycopg://projectrag:projectrag@127.0.0.1:54320/projectrag
PROJECT_RAG_DATA_DIR=./data
PROJECT_RAG_IMPORT_ROOT=./data/imports

# Retrieval: BGE-M3 remains the semantic embedding model.
PROJECT_RAG_EMBEDDING_DIM=1024
PROJECT_RAG_EMBEDDING_BACKEND=bge_m3
# Use a local directory here when the model is installed outside the HF cache,
# e.g. D:/chengdu-construction/models/bge-m3 on Windows.
PROJECT_RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Cross-encoder reranking is disabled. No reranker model is downloaded or required.
PROJECT_RAG_RERANKER_ENABLED=0

PROJECT_RAG_AUTO_START_WORKER=1
PROJECT_RAG_AUTH_REQUIRED=0
# Shared bearer between Tax and RAG. Required for non-loopback/protected deployments.
RAG_SHARED_API_KEY_FILE=
RAG_SHARED_API_KEY=
JWT_SECRET_KEY=

# Windows V3 local OpenAI-compatible model endpoint.
RAG_LLM_BASE_URL=http://127.0.0.1:8930/v1
RAG_LLM_MODEL=spark-x2.5-4b
RAG_LLM_API_KEY=local
# Managed local fallback uses the same canonical 8930 endpoint.
RAG_LLM_LOCAL_BASE_URL=http://127.0.0.1:8930/v1
RAG_LLM_LOCAL_MODEL=spark-x2.5-4b
RAG_LLM_LOCAL_TIMEOUT_SECONDS=60
