# ProjectRAG V0.2 Optimized Environment Configuration

# V0.2 primary database: PostgreSQL + pgvector
PROJECT_RAG_DB_URL=postgresql+psycopg://projectrag:projectrag@127.0.0.1:5432/projectrag
PROJECT_RAG_DATA_DIR=./data
PROJECT_RAG_HOST=127.0.0.1
PROJECT_RAG_PORT=8800

# MinerU lives in its own .mineru-venv
MINERU_BIN=mineru
# Apple Silicon can leave blank for MinerU auto selection; CPU-only use pipeline.
MINERU_BACKEND=
MINERU_API_URL=

# V0.2 semantic retrieval
PROJECT_RAG_EMBEDDING_BACKEND=bge_m3
PROJECT_RAG_EMBEDDING_MODEL=BAAI/bge-m3
PROJECT_RAG_EMBEDDING_DIM=1024
PROJECT_RAG_EMBEDDING_MAX_LENGTH=2048
PROJECT_RAG_RERANKER_BACKEND=bge_v2_m3
PROJECT_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PROJECT_RAG_RERANK_TOP_N=30

# Async ingest worker
PROJECT_RAG_AUTO_START_WORKER=1
PROJECT_RAG_WORKER_POLL_SECONDS=1.0

# Optional OpenAI-compatible answer model for /api/v1/query
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=

# ============================================
# OPTIMIZATION: Security & Limits
# ============================================

# Maximum upload file size (default 100MB)
PROJECT_RAG_MAX_UPLOAD_SIZE=104857600

# Rate limiting (requests per minute per IP)
PROJECT_RAG_RATE_LIMIT=60

# Job retry settings
PROJECT_RAG_MAX_JOB_RETRIES=3
PROJECT_RAG_JOB_RETRY_BACKOFF=30

# BM25 optimization
PROJECT_RAG_BM25_LIMIT=5000
PROJECT_RAG_BM25_POSTGRES_FTS=1

# Pagination
PROJECT_RAG_DEFAULT_PAGE_SIZE=50
PROJECT_RAG_MAX_PAGE_SIZE=200

# Logging level (DEBUG, INFO, WARNING, ERROR)
PROJECT_RAG_LOG_LEVEL=INFO
