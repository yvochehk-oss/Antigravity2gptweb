APP_ENV=development
# Mock AI is test-only and requires APP_ENV=test plus explicit opt-in.
AI_ALLOW_MOCK_ENDPOINTS=0
# Internal deployment policy: permit Tax AI loopback/RFC1918 HTTP or HTTPS.
# This flag applies only to AI endpoints; RAG outbound URL validation remains strict.
AI_ALLOW_PRIVATE_LLM=1
# Public AI hosts must be HTTPS and appear here; internal LLM hosts are
# governed by AI_ALLOW_PRIVATE_LLM instead of this public-provider allow-list.
AI_ALLOWED_HOSTS=tokenhub.tencentmaas.com
TAX_PORT=8921
# Explicit browser origins only; never use '*' with credentialed requests.
# Defaults are localhost/loopback on TAX_PORT plus common frontend dev ports.
TAX_CORS_ALLOW_ORIGINS=http://localhost:8921,http://127.0.0.1:8921,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Bounded total budget used by /healthz when probing configured AI chat endpoints.
AI_HEALTH_ENDPOINT_DEADLINE_SECONDS=1.5
DATABASE_URL=postgresql+psycopg://projectrag:projectrag@127.0.0.1:5432/projectrag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600
TAX_RAG_SERVICE_URL=http://127.0.0.1:8922
TAX_AUTO_SYNC_ENABLED=0
TAX_RAG_AUTH_REQUIRED=0
RAG_SHARED_API_KEY=
JWT_SECRET_KEY=
INITIAL_ADMIN_PASSWORD=
INITIAL_OPERATOR_PASSWORD=
TAX_AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
