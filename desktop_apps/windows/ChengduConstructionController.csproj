<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChengduConstructionController</RootNamespace>
    <AssemblyName>成都建工控制台3.1</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <Version>3.1.0</Version>
    <AssemblyTitle>成都建工控制台 3.1</AssemblyTitle>
    <AssemblyProduct>成都建工 V3.1</AssemblyProduct>
    <Description>成都建工 V3.1 Windows 桌面控制台</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests has its own .csproj and must never be compiled into the controller. -->
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>
</Project>
