<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChengduConstructionController</RootNamespace>
    <AssemblyName>成都建工控制台3.1</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <Version>3.1.0</Version>
    <AssemblyTitle>成都建工控制台 3.1</AssemblyTitle>
    <AssemblyProduct>成都建工 V3.1</AssemblyProduct>
    <Description>成都建工 V3.1 Windows 桌面控制台</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the Tests project subdirectory from this project; Tests has its
         own .csproj and should not be compiled into the controller binary. -->
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*.cs" />
    <EmbeddedResource Remove="Tests\**" />
  </ItemGroup>

</Project>
