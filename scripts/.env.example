# 成都建工 V3.1 根级编排配置（无密钥）
# 复制为 .env；不要把真实密钥放在这里。

# 本地 llama.cpp 主模型与保底：1=启动，0=跳过。缺模型/启动失败时 Tax/RAG 仍可启动，
# 但本地 AI 状态明确为 DEGRADED，不会伪装成 Mock 回复。
LOCAL_LLM_ENABLED=1
LOCAL_LLM_HOST=127.0.0.1
LOCAL_LLM_PORT=8930
LOCAL_LLM_MODEL=models/local-llm/Spark-X2.5-4B-Q4_K_M.gguf
# Windows llama-server (CPU x64):
LOCAL_LLM_SERVER_BIN=models/local-llm/runtime-win-cpu-x64/llama-server.exe
# macOS llama-server (Apple Silicon ARM64):
# LOCAL_LLM_SERVER_BIN=models/local-llm/runtime-macos-arm64/llama-server
LOCAL_LLM_ALIAS=Spark-X2.5-4B

# Windows 16 GB 内存/核显基线：默认保守参数，路径可写成绝对路径或相对路径。
# LOCAL_LLM_MODEL=C:/成都建工/V2.0/models/local-llm/Ling-3.0-tiny-Q4_K_M.gguf
# LOCAL_LLM_SERVER_BIN=models/local-llm/runtime-win-cpu-x64/llama-server.exe
# 默认 context 4096，日常最高可调至 8192
LOCAL_LLM_CTX_SIZE=4096
LOCAL_LLM_THREADS=4
LOCAL_LLM_THREADS_BATCH=4
LOCAL_LLM_BATCH_SIZE=512
LOCAL_LLM_UBATCH_SIZE=256
LOCAL_LLM_GPU_LAYERS=0
# 普通任务关闭 thinking（off），AI Review 复核场景按需开启（auto/on）
LOCAL_LLM_REASONING=off
LOCAL_LLM_STARTUP_TIMEOUT_SECONDS=180

# V3 IDP document intake service.  IDP uses its own isolated Python venv and
# inherits the shared DATABASE_URL from the Tax runtime at root startup.
IDP_ENABLED=1
IDP_HOST=127.0.0.1
IDP_PORT=8933

# 对照/兜底备用模型（保留不删）：
# LOCAL_LLM_MODEL=models/local-llm/Qwen3.5-2B-Q4_K_M.gguf
# LOCAL_LLM_ALIAS=local-qwen3.5-2b
# LOCAL_LLM_MODEL=models/local-llm/Qwen3.5-9B-Q4_K_M.gguf
# LOCAL_LLM_ALIAS=local-qwen3.5-9b

# 更换下载镜像时仅供 download_ling3_tiny.sh / download_qwen35_2b.sh 使用。
# LOCAL_LLM_MODEL_URL=https://hf-mirror.com/bartowski/Ling-3.0-tiny-GGUF/resolve/main/Ling-3.0-tiny-Q4_K_M.gguf
