# 成都建工 V2.0 根级编排配置（无密钥）
# 复制为 V2.0/.env；不要把真实密钥放在这里。

# 本地 llama.cpp 保底：1=启动，0=跳过。缺模型/启动失败时 Tax/RAG 仍可启动，
# 但本地 AI 状态明确为 DEGRADED，不会伪装成 Mock 回复。
LOCAL_LLM_ENABLED=1
LOCAL_LLM_HOST=127.0.0.1
LOCAL_LLM_PORT=8930
LOCAL_LLM_MODEL=models/local-llm/Qwen3.5-2B-Q4_K_M.gguf
LOCAL_LLM_SERVER_BIN=llama-server
LOCAL_LLM_ALIAS=local-qwen3.5-2b

# Windows 16 GB 内存/核显基线：默认保守参数，路径可写成绝对路径。
# LOCAL_LLM_MODEL=C:/成都建工/V2.0/models/local-llm/Qwen3.5-2B-Q4_K_M.gguf
# LOCAL_LLM_SERVER_BIN=C:/llama.cpp/build/bin/Release/llama-server.exe
LOCAL_LLM_CTX_SIZE=8192
LOCAL_LLM_THREADS=4
LOCAL_LLM_THREADS_BATCH=4
LOCAL_LLM_BATCH_SIZE=512
LOCAL_LLM_UBATCH_SIZE=256
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_REASONING=off
LOCAL_LLM_STARTUP_TIMEOUT_SECONDS=180

# 更换下载镜像时仅供 download_qwen35_2b.sh 使用。
# LOCAL_LLM_MODEL_URL=https://hf-mirror.com/unsloth/Qwen3.5-2B-GGUF/resolve/main/Qwen3.5-2B-Q4_K_M.gguf
